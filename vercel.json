{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    { "src": "^/_expo/static/(.*)$", "headers": { "cache-control": "public, max-age=31536000, immutable" }, "continue": true },
    { "src": "^/assets/(.*)$", "headers": { "cache-control": "public, max-age=31536000, immutable" }, "continue": true },
    { "src": "^/fonts/(.*)$", "headers": { "cache-control": "public, max-age=31536000, immutable" }, "continue": true },
    { "src": "^/(.*)$", "headers": { "x-content-type-options": "nosniff", "referrer-policy": "strict-origin-when-cross-origin" }, "continue": true },
    { "src": "^/(.+)\\.html$", "status": 308, "headers": { "location": "/$1" } },
    { "handle": "filesystem" },
    { "src": "^/(.+?)/?$", "dest": "/$1.html", "check": true },
    { "src": "^/.*$", "status": 404, "dest": "/+not-found.html" }
  ]
}
